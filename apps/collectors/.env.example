# World Pulse — Collectors — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file.

# ─── GitHub Collector ────────────────────────────────────────────────────────
# Personal access token (optional but recommended — raises rate limit to 5000/hr)
# Create one at https://github.com/settings/tokens (no scopes needed for public events)
GITHUB_TOKEN=

# ─── USGS Earthquake Feed ────────────────────────────────────────────────────
# No key required — USGS feeds are public
# USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_hour.geojson

# ─── NASA APIs ───────────────────────────────────────────────────────────────
# Get a free key at https://api.nasa.gov/
NASA_API_KEY=DEMO_KEY

# ─── News API ────────────────────────────────────────────────────────────────
# Get a free key at https://newsapi.org/
NEWS_API_KEY=

# ─── CoinGecko ───────────────────────────────────────────────────────────────
# Free tier works without a key; pro key increases rate limits
COINGECKO_API_KEY=

# ─── Wikimedia / Wikipedia ───────────────────────────────────────────────────
# No key required — Wikipedia API is public

# ─── Launch Library 2 / Hacker News / Open-Meteo ─────────────────────────────
# No keys required. All three have public endpoints.

# ─── Optional endpoint overrides (useful for local testing) ───────────────────
# USGS_FEED_URL=
# NASA_EONET_URL=
# COINGECKO_API_URL=
# NEWS_API_URL=
# WIKIMEDIA_API_URL=
# OPEN_METEO_API_URL=
# LAUNCH_LIBRARY_API_URL=
# HACKER_NEWS_API_URL=

# ─── Scheduler ───────────────────────────────────────────────────────────────
# Cron expression for how often collectors run (default: every 5 minutes)
COLLECTOR_CRON=*/5 * * * *

# API used to persist the normalized collector output.
WORLD_PULSE_API_URL=http://localhost:5000
# Must match WORLD_PULSE_INGEST_KEY in apps/api/.env.
WORLD_PULSE_INGEST_KEY=replace-with-a-long-random-secret

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
