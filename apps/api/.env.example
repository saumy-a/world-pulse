# Port the API listens on
PORT=5000

# MongoDB connection string (MongoDB Atlas). Never commit the real value.
DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/world-pulse

# Shared only by the API and collector service. Set the same long random value
# in both environments to enable POST /api/v1/events/ingest.
WORLD_PULSE_INGEST_KEY=replace-with-a-long-random-secret

# Redis connection string (planned for later, not used yet)
REDIS_URL=redis://localhost:6379

# Secret used to sign login tokens (JWT), planned for later
JWT_SECRET=change-me
